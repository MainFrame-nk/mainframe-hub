generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Проекты в твоем Хабе
model Project {
  id          String  @id @default(cuid())
  slug        String  @unique // Например: "okaeri-gaming"
  title       String // Название проекта
  tagline     String // Короткое описание для карточки
  description String? // Полное описание (Markdown)
  category    String  @default("DEV") // DEV, BUSINESS, WORK, FAMILY
  status      String  @default("ACTIVE") // IDEA, IN_DEV, ACTIVE, ARCHIVED
  isPublic    Boolean @default(true) // true = видно всем на главной, false = только тебе в Vault
  featured    Boolean @default(false) // Крупная карточка в Bento-сетке
  liveUrl     String? // Ссылка на сайт (например, https://okaeri-gaming.ru/)
  repoUrl     String? // Ссылка на GitHub
  techStack   String // Стек через запятую: "Next.js, Prisma, TypeScript"
  accentColor String  @default("purple") // purple, cyan, crimson

  stages       Stage[] // Этапы разработки
  notes        Note[] // Личные заметки по проекту
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  contacts     Contact[]
}

// 2. Этапы разработки (Роадмап проекта)
model Stage {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("TODO") // TODO, IN_PROGRESS, DONE
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 3. Личные заметки и мысли (Твой приватный блокнот в Хабе)
model Note {
  id         String  @id @default(cuid())
  title      String
  content    String // Текст заметки, команды, сниппеты кода
  category   String  @default("DEV") // DEV, BUSINESS, WORK, FAMILY
  eventType  String  @default("NOTE") // NOTE (Заметка), MEETING (Встреча), DEADLINE (Дедлайн), EVENT (Мероприятие)
  isPinned   Boolean @default(false)
  isArchived Boolean @default(false) // true = Выполнено / В архиве (не удалено!)

  // Поля для Ежедневника и Telegram-уведомлений:
  scheduledFor DateTime? // Дата и время события / встречи / дедлайна
  remindOffset Int? // За сколько минут предупредить в ТГ (напр. 15, 60, 1440). null = без уведомления
  reminderSent Boolean   @default(false) // Отправлено ли уже уведомление в Telegram

  projectId String? // Может быть привязана к проекту или быть общей
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
}

// Новая модель для заявок от клиентов с сайта
model Lead {
  id        String   @id @default(cuid())
  name      String // Имя клиента или компании
  contact   String // Telegram или Email
  message   String // Текст задачи
  status    String   @default("NEW") // NEW, IN_PROGRESS, CLOSED
  createdAt DateTime @default(now())
}

// Модель для файлов в твоем Облачном Хранилище
model CloudFile {
  id          String   @id @default(cuid())
  name        String // Имя файла
  size        Int // Размер в байтах
  mimeType    String // Тип (image/png, application/zip и т.д.)
  fileUrl     String // Ссылка на скачивание (Google Drive / локальное хранилище)
  driveFileId String? // ID файла на Google Диске для удаления
  createdAt   DateTime @default(now())
}

model AuthCode {
  id        String   @id @default(cuid())
  code      String // Сам 6-значный код
  expiresAt DateTime // Время жизни (например, 5 минут)
  used      Boolean  @default(false)
}

// МОДЕЛЬ ТРАНЗАКЦИЙ (ДОХОДЫ И РАСХОДЫ)
model Transaction {
  id          String   @id @default(cuid())
  type        String   @default("EXPENSE") // "INCOME" (Доход) или "EXPENSE" (Расход)
  amount      Float // Сумма
  category    String   @default("OTHER") // FOOD, SERVERS, BUSINESS, HOME, FUN, SALARY и т.д.
  description String? // Комментарий (зашифруем через AES-256)
  date        DateTime @default(now()) // Дата операции (для фильтра по месяцам)

  projectId String? // Привязка к проекту (опционально)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// МОДЕЛЬ ПЛАНОВ ПОКУПОК (WISHLIST / БЮДЖЕТИРОВАНИЕ)
model WishlistItem {
  id          String   @id @default(cuid())
  title       String // Название цели/покупки
  targetPrice Float // Целевая стоимость
  savedAmount Float    @default(0) // Сколько уже отложено
  priority    String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  category    String   @default("TECH")
  isBought    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// МОДЕЛЬ ЛЮДЕЙ И СВЯЗЕЙ (PERSONAL CRM - ЗАШИФРОВАНО AES-256)
model Contact {
  id        String  @id @default(cuid())
  name      String // Зашифровано AES-256
  avatarUrl String? // Зашифровано AES-256 (URL фото)
  tag       String  @default("PARTNER") // DEV, CLIENT, PARTNER, FRIEND, FAMILY
  role      String? // Например: "Backend Dev", "Инвестор", "Заказчик" (Зашифровано)
  telegram  String? // Зашифровано AES-256
  phone     String? // Зашифровано AES-256
  birthday  String? // Формат YYYY-MM-DD (Зашифровано AES-256)
  bio       String? // Личное досье / описание (Зашифровано AES-256)

  projectId String? // Привязка к команде проекта
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     Note[] // Заметки и задачи, связанные с этим человеком

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// МОДЕЛЬ ЛИЧНОГО РАДИО И АУДИОТЕКИ (MAINFRAME AUDIO)
model AudioTrack {
  id        String   @id @default(cuid())
  title     String // Зашифровано AES-256 (Название трека)
  artist    String // Зашифровано AES-256 (Исполнитель)
  genre     String   @default("CYBERPUNK") // CYBERPUNK, PHONK, SYNTHWAVE, FOCUS, ROCK, OTHER
  filename  String // Имя файла в закрытой папке storage/vault-audio
  fileSize  Int      @default(0) // Размер в байтах
  isFav     Boolean  @default(false) // Избранное (Сердечко)
  createdAt DateTime @default(now())
}
